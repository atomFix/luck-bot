+
+void AudioService::EnableCompanionCapture(bool enable) {
+    if (enable) {EnableVoiceProcessing(false); EnableWakeWordDetection(false); xEventGroupSetBits(event_group_, AS_EVENT_COMPANION_CAPTURE);}
+    else {xEventGroupClearBits(event_group_, AS_EVENT_COMPANION_CAPTURE); EnableWakeWordDetection(true);}
+}
+bool AudioService::PushCompanionPcm(const uint8_t* data, size_t bytes, uint32_t turn, bool end) {
+    if (!turn || bytes > 960 || bytes % 2) return false;
+    if (!bytes && !end) return true;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (audio_playback_queue_.size() >= 20) return false;
+    auto task = std::make_unique<AudioTask>(); task->timestamp=0;
+    task->companion_end=end; task->companion_turn=turn; task->companion_generation=companion_generation_.load();
+    task->pcm.resize(bytes/2); memcpy(task->pcm.data(),data,bytes);
+    audio_playback_queue_.push_back(std::move(task)); audio_queue_cv_.notify_all(); return true;
+}
+void AudioService::CancelCompanionPlayback() {
+    companion_generation_++;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    audio_playback_queue_.clear(); audio_decode_queue_.clear(); audio_encode_queue_.clear(); audio_send_queue_.clear();
+    audio_queue_cv_.notify_all();
+}
